#!/usr/bin/env bash
# Stop Claude Code agents that still have a running process (a "pid" in
# "claude agents --json"). Works from bash and zsh on macOS and Linux.
#
# Usage: stop-agents [-y|--yes] [-n|--dry-run] [-s|--state blocked,working]
#   -y, --yes       stop without asking
#   -n, --dry-run   only list what would be stopped
#   -s, --state     additionally restrict to these states (comma-separated)
# Conversations are kept: "claude attach <id>" or "claude --resume" reopens them.
set -euo pipefail

yes=0; dry=0; states=""
while [ $# -gt 0 ]; do
  case "$1" in
    -y|--yes) yes=1 ;;
    -n|--dry-run) dry=1 ;;
    -s|--state) shift; states="${1:-}" ;;
    --state=*) states="${1#*=}" ;;
    -h|--help) sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "unknown option: $1 (see --help)" >&2; exit 2 ;;
  esac
  shift
done

json="$(claude agents --json)" || { echo "claude agents --json failed" >&2; exit 1; }

# Emit: id<TAB>pid<TAB>state<TAB>status<TAB>name for agents that have a pid.
if command -v jq >/dev/null 2>&1; then
  rows="$(printf '%s' "$json" | jq -r --arg s "$states" '
    ($s | split(",") | map(gsub("^\\s+|\\s+$"; "")) | map(select(. != ""))) as $want
    | .[] | select(.pid != null)
    | select(($want | length) == 0 or (.state as $st | $want | index($st)))
    | [.id, (.pid|tostring), .state, (.status // ""), .name] | @tsv')"
elif command -v python3 >/dev/null 2>&1; then
  rows="$(printf '%s' "$json" | STATES="$states" python3 -c '
import json, os, sys
want = [s.strip() for s in os.environ["STATES"].split(",") if s.strip()]
for a in json.load(sys.stdin):
    if a.get("pid") and (not want or a.get("state") in want):
        print("\t".join(str(a.get(k, "")) for k in ("id", "pid", "state", "status", "name")))
')"
else
  echo "need jq or python3 to parse JSON" >&2; exit 1
fi

if [ -z "$rows" ]; then echo "No agents with a running process (pid) found."; exit 0; fi

count="$(printf '%s\n' "$rows" | wc -l | tr -d ' ')"
echo "Found $count agent(s) with a running process:"
{ printf 'ID\tPID\tSTATE\tSTATUS\tNAME\n'; printf '%s\n' "$rows"; } | column -t -s "$(printf '\t')"
echo

if [ "$dry" -eq 1 ]; then echo "Dry run: nothing stopped."; exit 0; fi

if [ "$yes" -ne 1 ]; then
  printf 'Stop all of them? [y/N] '
  read -r answer </dev/tty || answer=""
  case "$answer" in y|Y|yes|YES) ;; *) echo "Aborted."; exit 0 ;; esac
fi

failed=0
while IFS="$(printf '\t')" read -r id pid state status name; do
  printf 'Stopping %s (%s)... ' "$id" "$name"
  if claude stop "$id" >/dev/null 2>&1; then echo "ok"; else echo "failed"; failed=$((failed + 1)); fi
done <<EOF
$rows
EOF

echo "Done: $((count - failed)) stopped, $failed failed."
[ "$failed" -eq 0 ]
